<html>

<head>

<title>HRFlow360 Admin Dashboard</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#f4f6f9;
}

/* ================= HEADER ================= */

.header{
    height:70px;
    background:#1E3A8A;
    color:#fff;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:0 25px;
}

.logo{
    font-size:28px;
    font-weight:bold;
}

.top-menu{
    display:flex;
    gap:25px;
    font-size:16px;
}

/* ================= LAYOUT ================= */

.container{
    display:flex;
    min-height:calc(100vh - 120px);
}

/* ================= SIDEBAR ================= */

.sidebar{
    width:250px;
    background:#fff;
    border-right:1px solid #ddd;
}

.sidebar ul{
    list-style:none;
}

.sidebar li{
    padding:16px 20px;
    border-bottom:1px solid #f0f0f0;
    cursor:pointer;
}

.sidebar li:hover{
    background:#eef3ff;
}

.active{
    background:#dbe8ff;
    border-left:5px solid #1E3A8A;
    font-weight:bold;
}

/* ================= CONTENT ================= */

.content{
    flex:1;
    padding:30px;
}

.page-title{
    font-size:38px;
    color:#1E3A8A;
    margin-bottom:25px;
}

.placeholder{
    height:500px;
    background:#fff;
    border:2px dashed #ccc;
    border-radius:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#888;
    font-size:24px;
}

/* ================= FOOTER ================= */

.footer{
    height:50px;
    background:#1E3A8A;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
}

</style>

</head>

<body>

<div class="header">

    <div class="logo">
        HRFlow360
    </div>

    <div class="top-menu">
        <span>Search</span>
        <span>Notifications</span>
        <span>Admin</span>
    </div>

</div>

<div class="container">

    <div class="sidebar">

        <ul>

            <li class="active">Dashboard</li>

            <li>User Management</li>

            <li>Department Management</li>

            <li>Role Management</li>

            <li>Leave Management</li>

            <li>HR Case Management</li>

            <li>Analytics and Reports</li>

            <li>Audit Logs</li>

            <li>Notifications</li>

            <li>My Profile</li>

        </ul>

    </div>

    <div class="content">

        <div class="page-title">

            System Overview

        </div>

        <div class="placeholder">

            Dashboard Widgets Will Be Added Here

        </div>

    </div>

</div>

<div class="footer">

    © 2026 HRFlow360 | Unified HR Service Delivery Platform

</div>

</body>

</html>

