        <script><![CDATA[(function executeRule(current, previous) {

    if (!current.raised_by)
        return;

    var raisedBy = new GlideRecord('x_snc_unified_hr_0_employee_details');

    if (raisedBy.get(current.raised_by)) {

        var approver = new GlideRecord('x_snc_unified_hr_0_employee_details');

        approver.addQuery('department.name', 'Human Resources');

        if (raisedBy.role == 'HR') {
            approver.addQuery('role', 'Admin');
        } else {
            approver.addQuery('role', 'HR');
        }

        approver.setLimit(1);
        approver.query();

        if (approver.next()) {
            current.assigned_to = approver.user;
        }
    }

})(current, previous);]]></script>
